{
  "manifest_version": 3,
  "name": "X Reply Writer (Groq)",
  "short_name": "Reply Writer",
  "version": "1.0.0",
  "description": "Живі реплаї в X/Twitter українською через Groq: контекст → генерація → граматика → оцінка.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://api.groq.com/*", "https://api.languagetool.org/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "X Reply Writer",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "options_page": "src/options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
